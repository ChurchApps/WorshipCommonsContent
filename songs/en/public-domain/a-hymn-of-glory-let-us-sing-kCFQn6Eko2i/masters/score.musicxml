<score-partwise>
  <work>
    <work-number>(also known as Sing We Triumphant Hymns of Praise)</work-number>
    <work-title>A Hymn of Glory Let Us Sing</work-title>
  </work>
  <identification>
    <creator type="composer">Words: The Venerable Bede, 735. Translation composite of Elizabeth Rundle Charles, 1858 and Benjamin Webb, 1854.
Music: 'Lasst Uns Erfreuen' from Geistliche Kirchengesäng, Köln, 1623. Setting: Ralph Vaughan Williams, 1906.
copyright: public domain.  This score is a part of the Open Hymnal Project, 2026 Revision.</creator>
    <encoding>
      <encoder>abc2xml version 268</encoder>
      <software>https://wim.vree.org/svgParse/abc2xml.html</software>
      <encoding-date>2026-09-07</encoding-date>
    </encoding>
    <source>Music source: 'Lutheran Worship' Hymnal, 1982 Hymn 436.
Lyrics source: Composite from "A Collection of Hymns: Supplementary to the Psalms and Hymns of Dr. Watts", 1859 hymn 85 and "The English Hymnal", 1906 hymn 146</source>
    <miscellaneous>
      <miscellaneous-field name="lyrics">6. $1D$2 O risen Christ ascended Lord.
All praise to Thee let earth accord,
Alleluia! Alleluia!

Who are while endless ages run,
With Father and with Spirit One.  Alleluia!
Alleluia! Alleluia! Alleluia! Alleluia!</miscellaneous-field>
    </miscellaneous>
  </identification>
